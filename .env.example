# Local development only. Never commit .env or put keys in the browser.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Production requires a passcode of at least 16 characters.
SCANNER_ACCESS_CODE=
# Shared rate limits. Required in production (including single-replica deployments).
REDIS_URL=
SCANS_PER_MINUTE=5
SCANS_PER_DAY=100
# Set only behind a trusted HTTPS reverse proxy that strips this header.
TRUST_PROXY_SSL=0
